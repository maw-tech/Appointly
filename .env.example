# Copy this file to .env and adjust the values. Never commit .env.

# Tells the `flask` command where the application lives.
FLASK_APP=appointly

# Long random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# IANA timezone used for all appointment dates and times.
APPOINTLY_TIMEZONE=America/New_York

# Name shown to customers on the booking pages.
APPOINTLY_PROVIDER_NAME=Riverside Tutoring

# How many days ahead (including today) customers may book.
APPOINTLY_BOOKING_WINDOW_DAYS=14

# Optional: path to the SQLite database file.
# Defaults to instance\appointly.sqlite3 inside the project folder.
# APPOINTLY_DATABASE=C:\path\to\appointly.sqlite3

# Set to 1 only when serving over HTTPS.
SESSION_COOKIE_SECURE=0
